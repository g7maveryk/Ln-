local sacrificeThreads = {}
local function sacrificePet(pn) if not canExecute("sacrifice") then return end; local s = pcall(function() SacrificeRemote:InvokeServer("SacrificeWell", pn) end); if s then game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Sacrifice", Text = pn.." sacrificed!", Duration = 2 }) end; return s end
local function toggleSacrifice(pn, en) local k = pn:lower():gsub(" ", ""); if en then if sacrificeThreads[k] then task.cancel(sacrificeThreads[k]); sacrificeThreads[k] = nil end; sacrificeThreads[k] = task.spawn(function() pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", "SummerEventZone"); pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", "ElementEventZone1"); task.wait(1); while active and sacrificeActive[k] do sacrificePet(pn); task.wait(5) end end) else if sacrificeThreads[k] then task.cancel(sacrificeThreads[k]); sacrificeThreads[k] = nil end end end
local function stopAllSacrifices() for _,t in pairs(sacrificeThreads) do task.cancel(t) end; sacrificeThreads = {}; for k,_ in pairs(sacrificeActive) do sacrificeActive[k] = false end end
local function scanBosses() if not config.farmBosses then return end; local na = {}; for _,n in ipairs(bossList) do if bossEnabled[n] then local z = getZone("boss", bossZoneMap[n]); if z and z:FindFirstChild("Enemies") then local e = z.Enemies:FindFirstChild(n); if e then table.insert(na, e) end end end end; activeBosses = na end
local function bossScanWorker() while active do scanBosses(); task.wait(15) end end
local function updateEnemyThreads() for i=1,#enemyWorkers do if enemyWorkers[i] then task.cancel(enemyWorkers[i]) end end; enemyWorkers = {}; for i=1,config.enemyThreads do enemyWorkers[i] = task.spawn(createEnemyWorker(i)) end end
local function updateEggThreads() for i=1,#eggWorkers do if eggWorkers[i] then task.cancel(eggWorkers[i]) end end; eggWorkers = {}; for i=1,config.eggThreads do eggWorkers[i*3-2] = task.spawn(createEggWorker(i, "plant")); eggWorkers[i*3-1] = task.spawn(createEggWorker(i, "hatch")); eggWorkers[i*3] = task.spawn(createEggWorker(i, "nests")) end end
local allThreads = {}
local function stopAllThreads() for _,t in ipairs(allThreads) do if t then task.cancel(t) end end; allThreads = {}; for i=1,#enemyWorkers do if enemyWorkers[i] then task.cancel(enemyWorkers[i]) end end; for i=1,#eggWorkers do if eggWorkers[i] then task.cancel(eggWorkers[i]) end end; enemyWorkers = {}; eggWorkers = {}; activeBosses = {} end

local function start() if active then return end; active = true; scanBosses(); local t = { task.spawn(bossesWorker), task.spawn(foodWorker), task.spawn(bossScanWorker) }; for _,th in ipairs(t) do table.insert(allThreads, th) end; updateEnemyThreads(); updateEggThreads(); if sacrificeActive.queen then toggleSacrifice("Queen Bee", true) end; if sacrificeActive.king then toggleSacrifice("King Bee", true) end; if sacrificeActive.frozen then toggleSacrifice("Frozen Werewolf", true) end; if sacrificeActive.walrus then toggleSacrifice("Walrus", true) end; if sacrificeActive.fennec then toggleSacrifice("Fennec Fox", true) end; if sacrificeActive.mystic then toggleSacrifice("Mystic Camel", true) end end
local function stop() active = false; stopAllSacrifices(); stopAllThreads(); task.wait(1) end
