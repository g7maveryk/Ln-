-- ========== SISTEMA DE ATAQUE OTIMIZADO (FILA) ==========
local AttackQueue = {
    queue = {},
    processing = false,
    
    add = function(self, func)
        if #self.queue < 1000 then -- Limite de segurança
            table.insert(self.queue, func)
        end
    end,
    
    process = function(self)
        if self.processing then return end
        self.processing = true
        
        local startTime = os.clock()
        local processed = 0
        
        while #self.queue > 0 and processed < CONFIG.MAX_ATTACKS_PER_FRAME do
            local func = table.remove(self.queue, 1)
            local success, err = pcall(func)
            if not success then
                warn("Attack error: " .. tostring(err))
            end
            processed = processed + 1
            
            -- Controle de tempo: não passa mais que 5ms por frame
            if os.clock() - startTime > 0.005 then
                break
            end
        end
        
        self.processing = false
    end,
    
    clear = function(self)
        self.queue = {}
    end
}

-- Funções de ataque (leves, apenas enfileiram)
local function attackEnemy(enemy, pet)
    if RF.combat and enemy and pet then
        AttackQueue:add(function()
            pcall(RF.combat.InvokeServer, RF.combat, "AttackEnemy", enemy, pet)
        end)
    end
end

local function collectFood(food, pet)
    if RF.collect and food and pet then
        AttackQueue:add(function()
            pcall(RF.collect.InvokeServer, RF.collect, "CollectFood", food, pet)
        end)
    end
end

-- ========== FUNÇÕES DE FARM (LEVES) ==========
local function scanBosses()
    if not config.farmBosses then
        activeBosses = {}
        return
    end
    local newActive = {}
    for _, name in ipairs(BOSS_LIST) do
        if bossEnabled[name] then
            local zone = Cache:getZone(BOSS_ZONE_MAP[name])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local enemy = enemies:FindFirstChild(name)
                    if enemy then
                        table.insert(newActive, enemy)
                    end
                end
            end
        end
    end
    activeBosses = newActive
end

local function farmBosses()
    if #activeBosses == 0 then return end
    local pets = Cache:getPets()
    if #pets == 0 then return end
    
    local attackDelay = (currentSpeedMode == SPEED_MODES.LOW) and CONFIG.BOSS_ATTACK or CONFIG.FAST_BOSS_ATTACK
    
    for _, boss in ipairs(activeBosses) do
        if boss and boss.Parent then
            attackEnemy(boss, pets[1])
            if attackDelay > 0 then
                task.wait(attackDelay)
            end
        end
    end
end

local function farmEnemiesInZone(zoneName)
    local zone = Cache:getZone(zoneName)
    if not zone then return end
    local enemiesObj = zone:FindFirstChild("Enemies")
    if not enemiesObj then return end
    local enemies = enemiesObj:GetChildren()
    if #enemies == 0 then return end
    local pets = Cache:getPets()
    if #pets == 0 then return end
    
    for i = 1, math.min(#pets, #enemies) do
        attackEnemy(enemies[i], pets[i])
    end
end

local function farmEnemies()
    if not config.farmEnemies then return end
    for idx, zoneInfo in ipairs(ENEMY_ZONES) do
        if enemyEnabled[idx] then
            farmEnemiesInZone(zoneInfo.zone)
        end
    end
end

local function farmFood()
    if not config.farmFood then return end
    for _, foodZone in ipairs(FOOD_ZONES) do
        if foodZone.enabled then
            local zone = Cache:getZone(foodZone.zone)
            if zone then
                local foodSpawns = zone:FindFirstChild("FoodSpawns")
                if foodSpawns then
                    local foods = foodSpawns:GetChildren()
                    if #foods > 0 then
                        local pets = Cache:getPets()
                        if #pets > 0 then
                            for foodIdx, food in ipairs(foods) do
                                local pet = pets[((foodIdx-1) % #pets) + 1]
                                collectFood(food, pet)
                            end
                        end
                    end
                end
            end
        end
    end
end

local function farmPlant()
    if not config.autoPlant or #eggsSelected == 0 or not RF.plant then return end
    for _, zone in ipairs(eggsSelected) do
        for _ = 1, 9 do
            AttackQueue:add(function()
                pcall(RF.plant.FireServer, RF.plant, zone)
            end)
        end
    end
end

local function farmHatch()
    if not config.autoHatch or not RF.hatch then return end
    for _ = 1, 5 do
        AttackQueue:add(function()
            pcall(RF.hatch.FireServer, RF.hatch)
        end)
    end
end

local function farmNests()
    if not config.autoNests or not RF.feed then return end
    local nests = Cache:getNests()
    if nests then
        for _, nest in ipairs(nests:GetChildren()) do
            for _ = 1, 5 do
                AttackQueue:add(function()
                    pcall(RF.feed.FireServer, RF.feed, nest)
                end)
            end
        end
    end
end

-- ========== SISTEMA DE AGENDAMENTO PROFISSIONAL ==========
local Scheduler = {
    tasks = {},
    lastGarbageCollection = 0,
}

function Scheduler:add(name, func, interval, priority)
    table.insert(self.tasks, {
        name = name,
        func = func,
        interval = interval,
        nextRun = os.clock(),
        priority = priority or 5,
    })
    -- Ordenar por prioridade (menor = mais prioritário)
    table.sort(self.tasks, function(a, b) return a.priority < b.priority end)
end

function Scheduler:run()
    local now = os.clock()
    
    -- Coleta de lixo automática a cada 5 minutos
    if now - self.lastGarbageCollection > 300 then
        collectgarbage()
        self.lastGarbageCollection = now
    end
    
    for _, task in ipairs(self.tasks) do
        if now >= task.nextRun then
            local success, err = pcall(task.func)
            if not success then
                warn("Scheduler error in " .. task.name .. ": " .. tostring(err))
            end
            task.nextRun = now + task.interval
        end
    end
end

-- ========== MAIN LOOP (ÚNICA THREAD COM HEARTBEAT) ==========
local active = false
local mainThread = nil
local heartbeatConn = nil

local function mainLoop()
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not active then return end
        
        -- Executa tarefas agendadas
        Scheduler:run()
        
        -- Processa fila de ataques
        AttackQueue:process()
    end)
    
    -- Mantém a thread viva
    while active do
        task.wait(1)
    end
    
    if heartbeatConn then
        heartbeatConn:Disconnect()
        heartbeatConn = nil
    end
end

-- ========== FUNÇÕES DE CONTROLE ==========
local function getCurrentDelays()
    if currentSpeedMode == SPEED_MODES.LOW then
        return {
            bossCycle = CONFIG.BOSS_CYCLE,
            bossAttack = CONFIG.BOSS_ATTACK,
            enemyCycle = CONFIG.ENEMY_CYCLE,
            foodCycle = CONFIG.FOOD_CYCLE,
            eggCycle = CONFIG.EGG_CYCLE,
        }
    else
        return {
            bossCycle = CONFIG.FAST_BOSS_CYCLE,
            bossAttack = CONFIG.FAST_BOSS_ATTACK,
            enemyCycle = CONFIG.FAST_ENEMY_CYCLE,
            foodCycle = CONFIG.FAST_FOOD_CYCLE,
            eggCycle = CONFIG.FAST_EGG_CYCLE,
        }
    end
end

local function start()
    if active then return end
    active = true
    
    -- Limpa tasks antigas
    Scheduler.tasks = {}
    AttackQueue:clear()
    Cache:refresh()
    
    -- Pré-carrega zonas importantes
    if RF.zones then
        pcall(RF.zones.InvokeServer, RF.zones, "RequestZoneMap", "Zone12.1")
        pcall(RF.zones.InvokeServer, RF.zones, "RequestZoneMap", "SummerEventZone")
        pcall(RF.zones.InvokeServer, RF.zones, "RequestZoneMap", "WinterEventZone")
        pcall(RF.zones.InvokeServer, RF.zones, "RequestZoneMap", "ElementEventZone1")
    end
    
    local delays = getCurrentDelays()
    
    -- Scan inicial de bosses
    scanBosses()
    
    -- Adiciona tasks com prioridades (1 = mais prioritário)
    Scheduler:add("bossScan", scanBosses, 15, 1)
    Scheduler:add("bossAttack", farmBosses, delays.bossCycle, 1)
    Scheduler:add("enemyAttack", farmEnemies, delays.enemyCycle, 2)
    Scheduler:add("foodCollect", farmFood, delays.foodCycle, 3)
    Scheduler:add("plant", farmPlant, delays.eggCycle, 4)
    Scheduler:add("hatch", farmHatch, delays.eggCycle, 4)
    Scheduler:add("nests", farmNests, delays.eggCycle, 4)
    
    -- Inicia main loop
    mainThread = task.spawn(mainLoop)
    
    local modeText = (currentSpeedMode == SPEED_MODES.LOW) and "Low Mode" or "Fast Mode"
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "GK Hub",
        Text = "Farm started! " .. modeText,
        Duration = 3
    })
end

local function stop()
    active = false
    if mainThread then
        task.cancel(mainThread)
        mainThread = nil
    end
    activeBosses = {}
    AttackQueue:clear()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "GK Hub",
        Text = "Farm stopped.",
        Duration = 2
    })
end

