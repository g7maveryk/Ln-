-- Utilitários
local function getDelays()
    if config.speedMode == speedModes.LIGHT then
        return {
            bossDelay = config.bossDelay,
            bossAttackDelay = config.bossAttackDelay,
            enemyDelay = config.enemyDelay,
            foodDelay = config.foodDelay,
            eggDelay = config.eggDelay,
        }
    else
        return {
            bossDelay = config.fastBossDelay,
            bossAttackDelay = config.fastBossAttackDelay,
            enemyDelay = config.fastEnemyDelay,
            foodDelay = config.fastFoodDelay,
            eggDelay = config.fastEggDelay,
        }
    end
end

-- Funções de ataque
local function safeAttackEnemy(enemy, pet)
    if CombatRemote then
        pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", enemy, pet)
    end
end

local function safeCollectFood(food, pet)
    if CollectionRemote then
        pcall(CollectionRemote.InvokeServer, CollectionRemote, "CollectFood", food, pet)
    end
end

-- Ataque a bosses
local function attackBosses()
    if #activeBosses == 0 then return end
    local pets = updatePets()
    if #pets == 0 then return end
    local delays = getDelays()
    
    for _, boss in ipairs(activeBosses) do
        if boss and boss.Parent then
            task.spawn(function()
                safeAttackEnemy(boss, pets[1])
                if delays.bossAttackDelay > 0 then
                    task.wait(delays.bossAttackDelay)
                end
            end)
        end
    end
end

-- Ataque a inimigos
local function attackEnemiesInZone(zoneName)
    local zone = zoneCache[zoneName]
    if not zone then return end
    local enemiesObj = zone:FindFirstChild("Enemies")
    if not enemiesObj then return end
    local enemies = enemiesObj:GetChildren()
    if #enemies == 0 then return end
    local pets = updatePets()
    if #pets == 0 then return end
    
    for i = 1, math.min(#pets, #enemies) do
        task.spawn(function()
            safeAttackEnemy(enemies[i], pets[i])
        end)
    end
end

-- Coleta de comida
local function collectFood()
    for _, foodZone in ipairs(foodZones) do
        if foodZone.enabled then
            local zone = zoneCache[foodZone.zone]
            if zone then
                local foodSpawns = zone:FindFirstChild("FoodSpawns")
                if foodSpawns then
                    local foods = foodSpawns:GetChildren()
                    if #foods > 0 then
                        local pets = updatePets()
                        if #pets > 0 then
                            for foodIndex, food in ipairs(foods) do
                                local pet = pets[((foodIndex-1) % #pets) + 1]
                                task.spawn(function()
                                    safeCollectFood(food, pet)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end

