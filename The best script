                end)
            end
        end
    end
end

-- Scan de bosses
local function scanBosses()
    if not config.farmBosses then
        activeBosses = {}
        return
    end
    local newActive = {}
    for _, name in ipairs(bossList) do
        if bossEnabled[name] then
            local zone = zoneCache[bossZoneMap[name]]
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local enemy = enemies:FindFirstChild(name)
                    if enemy then
                        table.insert(newActive, enemy)
                    end
                end
            end
        end
    end
    activeBosses = newActive
end

-- Sacrifício
local function sacrificePet(petName)
    if SacrificeRemote then
        local success = pcall(function()
            SacrificeRemote:InvokeServer("SacrificeWell", petName)
        end)
        if success then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Sacrifice",
                Text = petName .. " sacrificed!",
                Duration = 1
            })
        end
    end
end

-- Variáveis de controle
local active = false
local farmThread = nil

-- Sistema de agendamento com threads independentes
local function startTask(name, func, interval)
    task.spawn(function()
        while active do
            local success, err = pcall(func)
            if not success then
                warn("Error in task " .. name .. ": " .. tostring(err))
            end
            task.wait(interval)
        end
    end)
end

-- Loop principal (apenas para manter o script vivo)
local function farmLoop()
    while active do
        task.wait(1)
    end
end

-- Iniciar farm
local function start()
    if active then return end
    active = true

    -- Pré-carregar zonas
    if ZonesRF then
        pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", "Zone12.1")
        pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", "SummerEventZone")
        pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", "WinterEventZone")
        pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", "ElementEventZone1")
    end

    local delays = getDelays()

    -- Scan de bosses (a cada 15s)
    startTask("bossScan", scanBosses, 15)

    -- Ataque a bosses (a cada 6s)
    startTask("bossAttack", function()
        if config.farmBosses and #activeBosses > 0 then
            attackBosses()
        end
    end, delays.bossDelay)

    -- Enemies (contínuo)
    startTask("enemyAttack", function()
        if config.farmEnemies then
            for idx, zoneInfo in ipairs(enemyZones) do
                if enemyEnabled[idx] then
                    attackEnemiesInZone(zoneInfo.zone)
                end
            end
        end
    end, delays.enemyDelay)

    -- Food
    startTask("foodCollect", function()
        if config.farmFood then
            collectFood()
        end
    end, delays.foodDelay)

    -- Eggs
    startTask("plant", function()
        if config.autoPlant then
            doPlanting()
        end
    end, delays.eggDelay)

    startTask("hatch", function()
        if config.autoHatch then
            doHatching()
        end
    end, delays.eggDelay)

    startTask("nests", function()
        if config.autoNests then
            doNests()
        end
    end, delays.eggDelay)

    -- Thread principal
    farmThread = task.spawn(farmLoop)

    local modeText = config.speedMode == speedModes.LIGHT and "Low Mode" or "Fast Mode"
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "GK Hub",
        Text = "Farm started! " .. modeText,
        Duration = 3
    })
end

-- Parar farm
local function stop()
    active = false
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
    activeBosses = {}
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "GK Hub",
        Text = "Farm stopped.",
        Duration = 2
    })
end

-- Remover animação de hatch
local function removeHatchAnimation()
    local ev = ReplicatedStorage and ReplicatedStorage:FindFirstChild("Remotes")
            and ReplicatedStorage.Remotes:FindFirstChild("Events")
            and ReplicatedStorage.Remotes.Events:FindFirstChild("HatchAnimationEvent")
    if ev then
        ev:Destroy()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Animation Removed",
            Text = "HatchAnimationEvent destroyed!",
            Duration = 3
        })
    else
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Error",
            Text = "HatchAnimationEvent not found.",
            Duration = 3
        })
    end
end

