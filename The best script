local crashDetected = false
local mainThreadHandle = nil
local scanThreadHandle = nil

local function mainLoop()
    while active do
        cycleCount = cycleCount + 1
        local startTime = os.clock()
        local now = os.clock()
        
        performance.fps = 1 / (now - performance.lastFrameTime + 0.001)
        performance.lastFrameTime = now
        
        if performance.fps < 30 and performance.mode == "normal" then
            performance.mode = "eco"
            config.bossAttackSpeed = 0.1
            config.enemiesSpeed = 0.1
            config.foodSpeed = 0.1
        elseif performance.fps > 45 and performance.mode == "eco" then
            performance.mode = "normal"
            config.bossAttackSpeed = 0.03
            config.enemiesSpeed = 0.05
            config.foodSpeed = 0.03
        end
        
        if cycleCount % 100 == 0 then
            collectgarbage("collect")
        end
        
        if os.clock() - lastCheckpoint > 300 then
            saveCheckpoint()
            lastCheckpoint = os.clock()
        end
        
        if os.clock() - lastActivity > 60 and active then
            crashDetected = true
            stop()
            task.wait(2)
            start()
            lastActivity = os.clock()
        end
        
        for _, task in ipairs(taskOrder) do
            if active and task.func then
                local success, err = pcall(task.func)
                if not success then
                    warn("Error in task " .. task.name .. ": " .. tostring(err))
                end
            end
        end
        
        local elapsed = os.clock() - startTime
        if elapsed < 0.1 then
            task.wait(0.1 - elapsed)
        else
            task.wait(0.05)
        end
    end
end

local function bossScanLoop()
    while active do
        if canDoAction("bossScan", 15) then
            scanBosses()
        end
        task.wait(1)
    end
end

-- Watchdog to ensure loops are running
local function watchdog()
    while true do
        task.wait(10)
        if active then
            if not mainThreadHandle or not task.isrunning(mainThreadHandle) then
                warn("Main loop died, restarting...")
                if mainThreadHandle then task.cancel(mainThreadHandle) end
                mainThreadHandle = task.spawn(mainLoop)
            end
            if not scanThreadHandle or not task.isrunning(scanThreadHandle) then
                warn("Scan loop died, restarting...")
                if scanThreadHandle then task.cancel(scanThreadHandle) end
                scanThreadHandle = task.spawn(bossScanLoop)
            end
        end
    end
end

local GlobalConnections = {
    list = {},
    add = function(self, name, conn)
        if self.list[name] then
            self.list[name]:Disconnect()
        end
        self.list[name] = conn
    end,
    remove = function(self, name)
        if self.list[name] then
            self.list[name]:Disconnect()
            self.list[name] = nil
        end
    end,
    clear = function(self)
        for _, conn in pairs(self.list) do
            conn:Disconnect()
        end
        self.list = {}
    end
}

local memoryWatchdog = task.spawn(function()
    while true do
        task.wait(30)
        local mem = collectgarbage("count") / 1024
        if mem > 100 then
            collectgarbage("collect")
            petCacheValid = false
            nestsCache = nil
        end
    end
end)

local watchdogThread = task.spawn(watchdog)

local function startLoop(name, func)
    if loopThreads[name] then
        task.cancel(loopThreads[name])
    end
    loopThreads[name] = task.spawn(func)
end

local function stopLoop(name)
    if loopThreads[name] then
        task.cancel(loopThreads[name])
        loopThreads[name] = nil
    end
end

local function stopAllLoops()
    for name, _ in pairs(loopThreads) do
        task.cancel(loopThreads[name])
        loopThreads[name] = nil
    end
    if mainThreadHandle then task.cancel(mainThreadHandle) mainThreadHandle = nil end
    if scanThreadHandle then task.cancel(scanThreadHandle) scanThreadHandle = nil end
    activeBosses = {}
    petCacheValid = false
    GlobalConnections:clear()
end

local function start()
    if startDebounce or active then return end
    startDebounce = true
    task.delay(1, function() startDebounce = false end)
    
    active = true
    petCacheValid = false
    lastActivity = os.clock()
    
    mainThreadHandle = task.spawn(mainLoop)
    scanThreadHandle = task.spawn(bossScanLoop)
end

local function stop()
    active = false
    stopAllLoops()
end

