local petCounter = 0
local function getNextPet() local p = getPets(); if #p == 0 then return nil end; petCounter = (petCounter % #p) + 1; return p[petCounter] end
local function attackEnemyDistributed(e) if not canExecute("enemies") then return end; local p = getNextPet(); if p then addToBatch(function() pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", e, p) end) end end

local enemyWorkers = {}; local eggWorkers = {}
local function createEnemyWorker(id)
    return function()
        while active do
            if config.farmEnemies then
                for i, enemy in ipairs(enemyList) do
                    if enemyEnabled[i] then
                        if enemy.a then
                            local zone = getZone("enemy", enemy.z)
                            if zone and zone:FindFirstChild("Enemies") then
                                local enemies = zone.Enemies:GetChildren()
                                for _, e in ipairs(enemies) do
                                    attackEnemyDistributed(e)
                                    task.wait(0.2)
                                end
                            end
                        else
                            local zone = getZone("enemy", enemy.z)
                            if zone and zone:FindFirstChild("Enemies") then
                                local e = zone.Enemies:FindFirstChild(enemy.e)
                                if e then 
                                    attackEnemyDistributed(e)
                                    task.wait(0.2)
                                end
                            end
                        end
                        task.wait(config.enemiesSpeed)
                    end
                end
            end
            task.wait(0.5)
        end
    end
end

local function bossesWorker()
    while active do
        if config.farmBosses then
            for _, boss in ipairs(activeBosses) do
                if boss and boss.Parent then
                    local pet = getNextPet()
                    if pet then
                        addToBatch(function()
                            pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", boss, pet)
                        end)
                    end
                    task.wait(config.bossSpeed)
                end
            end
        end
        task.wait(0.5)
    end
end

local function foodWorker()
    while active do
        if config.farmFood then
            for _, foodZone in ipairs(foodZones) do
                if foodZone.e then
                    local zone = getZone("food", foodZone.z)
                    if zone and zone:FindFirstChild("FoodSpawns") then
                        local foods = zone.FoodSpawns:GetChildren()
                        for _, f in ipairs(foods) do
                            local pet = getNextPet()
                            if pet then
                                addToBatch(function()
                                    pcall(CollectionRemote.InvokeServer, CollectionRemote, "CollectFood", f, pet)
                                end)
                            end
                            task.wait(0.2)
                        end
                    end
                    task.wait(config.foodSpeed)
                end
            end
        end
        task.wait(0.5)
    end
end

local function createEggWorker(id, t)
    if t == "plant" then
        return function()
            while active do
                if config.autoPlant and #eggsSelected > 0 and canExecute("eggs") then
                    for _,z in ipairs(eggsSelected) do
                        for _=1,9 do
                            addToBatch(function() pcall(PlantRemote.FireServer, PlantRemote, z) end)
                        end
                    end
                end
                task.wait(config.plantSpeed)
            end
        end
    elseif t == "hatch" then
        return function()
            while active do
                if config.autoHatch and canExecute("eggs") then
                    addToBatch(function() pcall(HatchRemote.FireServer, HatchRemote) end)
                end
                task.wait(config.hatchSpeed)
            end
        end
    elseif t == "nests" then
        return function()
            while active do
                if config.autoNests and canExecute("eggs") then
                    local n = getNests()
                    if n then
                        for _,ne in ipairs(n:GetChildren()) do
                            addToBatch(function() pcall(FeedRemote.FireServer, FeedRemote, ne) end)
                        end
                    end
                end
                task.wait(config.nestsSpeed)
            end
        end
    end
end

