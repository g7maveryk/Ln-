local petCounter = 0
local function getNextPet()
    local pets = getPets()
    if #pets == 0 then return nil end
    petCounter = (petCounter % #pets) + 1
    return pets[petCounter]
end

local function attackEnemyDistributed(enemy)
    if not canExecute("enemies") then return end
    local pet = getNextPet()
    if pet then
        addToBatch(function()
            pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", enemy, pet)
        end)
    end
end

local enemyWorkers = {}
local eggWorkers = {}

local function createEnemyWorker(workerId)
    return function()
        while active do
            if config.farmEnemies then
                for idx, enemy in ipairs(enemyList) do
                    if enemyEnabled[idx] then
                        if enemy.attackAll then
                            local zone = getZone("enemy", enemy.zone)
                            if zone and zone:FindFirstChild("Enemies") then
                                local enemies = zone.Enemies:GetChildren()
                                for _, e in ipairs(enemies) do
                                    attackEnemyDistributed(e)
                                end
                            end
                        else
                            local zone = getZone("enemy", enemy.zone)
                            if zone and zone:FindFirstChild("Enemies") then
                                local e = zone.Enemies:FindFirstChild(enemy.enemy)
                                if e then attackEnemyDistributed(e) end
                            end
                        end
                    end
                end
            end
            task.wait(config.enemiesSpeed)
        end
    end
end

local function createEggWorker(workerId, type)
    if type == "plant" then
        return function()
            while active do
                if config.autoPlant and #eggsSelected > 0 and canExecute("eggs") then
                    for _, zone in ipairs(eggsSelected) do
                        for _ = 1, 9 do
                            addToBatch(function()
                                pcall(PlantRemote.FireServer, PlantRemote, zone)
                            end)
                        end
                    end
                end
                task.wait(config.plantSpeed)
            end
        end
    elseif type == "hatch" then
        return function()
            while active do
                if config.autoHatch and canExecute("eggs") then
                    addToBatch(function()
                        pcall(HatchRemote.FireServer, HatchRemote)
                    end)
                end
                task.wait(config.hatchSpeed)
            end
        end
    elseif type == "nests" then
        return function()
            while active do
                if config.autoNests and canExecute("eggs") then
                    local nests = getNests()
                    if nests then
                        for _, nest in ipairs(nests:GetChildren()) do
                            addToBatch(function()
                                pcall(FeedRemote.FireServer, FeedRemote, nest)
                            end)
                        end
                    end
                end
                task.wait(config.nestsSpeed)
            end
        end
    end
end

local function bossesWorker()
    while active do
        if config.farmBosses and canExecute("bosses") then
            for _, boss in ipairs(activeBosses) do
                if boss and boss.Parent then
                    local pet = getNextPet()
                    if pet then
                        addToBatch(function()
                            pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", boss, pet)
                        end)
                    end
                end
            end
        end
        task.wait(config.bossSpeed)
    end
end

local function foodWorker()
    while active do
        if config.farmFood and canExecute("food") then
            for _, foodZone in ipairs(foodZones) do
                if foodZone.enabled then
                    local zone = getZone("food", foodZone.zone)
                    if zone and zone:FindFirstChild("FoodSpawns") then
                        local foods = zone.FoodSpawns:GetChildren()
                        for _, f in ipairs(foods) do
                            local pet = getNextPet()
                            if pet then
                                addToBatch(function()
                                    pcall(CollectionRemote.InvokeServer, CollectionRemote, "CollectFood", f, pet)
                                end)
                            end
                        end
                    end
                end
            end
        end
        task.wait(config.foodSpeed)
    end
end

local sacrificeActive = {
    queen = false, king = false, frozen = false,
    walrus = false, fennec = false, mystic = false
}
local sacrificeThreads = {}

local function sacrificePet(petName)
    if not canExecute("sacrifice") then return end
    local success = pcall(function()
        SacrificeRemote:InvokeServer("SacrificeWell", petName)
    end)
    if success then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Sacrifice", Text = petName .. " sacrificed!", Duration = 2
        })
    end
    return success
end

local function toggleSacrifice(petName, enable)
    local key = petName:lower():gsub(" ", "")
    if enable then
        if sacrificeThreads[key] then
            task.cancel(sacrificeThreads[key])
            sacrificeThreads[key] = nil
        end
        sacrificeThreads[key] = task.spawn(function()
            pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", "SummerEventZone")
            pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", "ElementEventZone1")
            task.wait(1)
            while active and sacrificeActive[key] do
                sacrificePet(petName)
                task.wait(5)
            end
        end)
    else
        if sacrificeThreads[key] then
            task.cancel(sacrificeThreads[key])
            sacrificeThreads[key] = nil
        end
    end
end

local function stopAllSacrifices()
    for _, thread in pairs(sacrificeThreads) do
        task.cancel(thread)
    end
    sacrificeThreads = {}
    for k in pairs(sacrificeActive) do
        sacrificeActive[k] = false
    end
end

local function scanBosses()
    if not config.farmBosses then return end
    local newActive = {}
    for _, name in ipairs(bossList) do
        if bossEnabled[name] then
            local zone = getZone("boss", bossZoneMap[name])
            if zone and zone:FindFirstChild("Enemies") then
                local enemy = zone.Enemies:FindFirstChild(name)
                if enemy then
                    table.insert(newActive, enemy)
                end
            end
        end
    end
    activeBosses = newActive
end

local function bossScanWorker()
    while active do
        scanBosses()
        task.wait(15)
    end
end

local function updateEnemyThreads()
    for i = 1, #enemyWorkers do
        if enemyWorkers[i] then task.cancel(enemyWorkers[i]) end
    end
    enemyWorkers = {}
    for i = 1, config.enemyThreads do
        enemyWorkers[i] = task.spawn(createEnemyWorker(i))
    end
end

local function updateEggThreads()
    for i = 1, #eggWorkers do
        if eggWorkers[i] then task.cancel(eggWorkers[i]) end
    end
    eggWorkers = {}
    for i = 1, config.eggThreads do
        eggWorkers[i * 3 - 2] = task.spawn(createEggWorker(i, "plant"))
        eggWorkers[i * 3 - 1] = task.spawn(createEggWorker(i, "hatch"))
        eggWorkers[i * 3] = task.spawn(createEggWorker(i, "nests"))
    end
end

local allThreads = {}
local function stopAllThreads()
    for _, thread in ipairs(allThreads) do
        if thread then task.cancel(thread) end
    end
    allThreads = {}
    for i = 1, #enemyWorkers do
        if enemyWorkers[i] then task.cancel(enemyWorkers[i]) end
    end
    for i = 1, #eggWorkers do
        if eggWorkers[i] then task.cancel(eggWorkers[i]) end
    end
    enemyWorkers = {}
    eggWorkers = {}
    activeBosses = {}
end



local function start()
    if active then return end
    active = true
    scanBosses()
    local threads = {
        task.spawn(bossesWorker),
        task.spawn(foodWorker),
        task.spawn(bossScanWorker)
    }
    for _, thread in ipairs(threads) do
        table.insert(allThreads, thread)
    end
    updateEnemyThreads()
    updateEggThreads()
    if sacrificeActive.queen then toggleSacrifice("Queen Bee", true) end
    if sacrificeActive.king then toggleSacrifice("King Bee", true) end
    if sacrificeActive.frozen then toggleSacrifice("Frozen Werewolf", true) end
    if sacrificeActive.walrus then toggleSacrifice("Walrus", true) end
    if sacrificeActive.fennec then toggleSacrifice("Fennec Fox", true) end
    if sacrificeActive.mystic then toggleSacrifice("Mystic Camel", true) end
end

local function stop()
    active = false
    stopAllSacrifices()
    stopAllThreads()
    task.wait(1)
end

