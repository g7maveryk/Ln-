-- ========== CACHE INTELIGENTE ==========
local Cache = {
    pets = {},
    nests = nil,
    zones = {},
    lastUpdate = {
        pets = 0,
        nests = 0,
        zones = 0,
    },
    
    getPets = function(self)
        local now = os.clock()
        if now - self.lastUpdate.pets > CONFIG.CACHE_TTL.PETS then
            if LocalPlayer.Character then
                local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
                if petsObj then
                    local pets = petsObj:GetChildren()
                    for i = 1, #pets do
                        self.pets[i] = pets[i]
                    end
                    for i = #pets + 1, #self.pets do
                        self.pets[i] = nil
                    end
                else
                    for i = 1, #self.pets do self.pets[i] = nil end
                end
            else
                for i = 1, #self.pets do self.pets[i] = nil end
            end
            self.lastUpdate.pets = now
        end
        return self.pets
    end,
    
    getNests = function(self)
        local now = os.clock()
        if now - self.lastUpdate.nests > CONFIG.CACHE_TTL.NESTS then
            self.nests = Workspace:FindFirstChild("Nests")
            self.lastUpdate.nests = now
        end
        return self.nests
    end,
    
    getZone = function(self, zoneName)
        local now = os.clock()
        if now - self.lastUpdate.zones > CONFIG.CACHE_TTL.ZONES then
            -- Recarrega todas as zonas a cada 5 minutos
            self.zones = {}
            self.lastUpdate.zones = now
        end
        if not self.zones[zoneName] then
            local success, result = pcall(function()
                return Workspace.Zones:FindFirstChild(zoneName)
            end)
            if success and result then
                self.zones[zoneName] = result
            end
        end
        return self.zones[zoneName]
    end,
    
    -- Força atualização (quando necessário)
    refresh = function(self)
        self.lastUpdate.pets = 0
        self.lastUpdate.nests = 0
        self.lastUpdate.zones = 0
    end
}

