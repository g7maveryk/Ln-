local function canExecute(cat) local l = rateLimits[cat]; local n = os.clock(); if n - l.l > 1 then l.c = 0; l.l = n end; if l.c < l.m then l.c = l.c + 1; return true end return false end
local floodControl = { c = 0, l = 0, t = 50 }
local function checkFlood() local n = os.clock(); if n - floodControl.l > 1 then if floodControl.c > floodControl.t then for _,l in pairs(rateLimits) do l.m = math.floor(l.m * 0.7) end end; floodControl.c = 0; floodControl.l = n end; floodControl.c = floodControl.c + 1 end
