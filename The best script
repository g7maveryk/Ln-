-- Pool de conexões
local ConnectionPool = {
    connections = {},
    add = function(self, name, conn)
        if self.connections[name] then
            self.connections[name]:Disconnect()
        end
        self.connections[name] = conn
    end,
    clear = function(self)
        for _, conn in pairs(self.connections) do
            conn:Disconnect()
        end
        self.connections = {}
    end
}

-- Rate limiting (10 bosses, 15 food, 15 eggs por segundo)
local rateLimits = {
    bosses = { count = 0, max = 10, lastReset = os.clock() },
    enemies = { count = 0, max = 15, lastReset = os.clock() },
    food = { count = 0, max = 15, lastReset = os.clock() },
    eggs = { count = 0, max = 15, lastReset = os.clock() },
    sacrifice = { count = 0, max = 5, lastReset = os.clock() }
}

local function canExecute(category)
    local limit = rateLimits[category]
    local now = os.clock()
    if now - limit.lastReset > 1 then
        limit.count = 0
        limit.lastReset = now
    end
    if limit.count < limit.max then
        limit.count = limit.count + 1
        return true
    end
    return false
end

-- Detector de flood automático
local floodControl = {
    counter = 0,
    lastReset = os.clock(),
    threshold = 50
}

local function checkFlood()
    local now = os.clock()
    if now - floodControl.lastReset > 1 then
        if floodControl.counter > floodControl.threshold then
            for cat, limit in pairs(rateLimits) do
                limit.max = math.floor(limit.max * 0.7)
            end
        end
        floodControl.counter = 0
        floodControl.lastReset = now
    end
    floodControl.counter = floodControl.counter + 1
end

-- Memory watchdog
local memoryWatchdog = {
    checkInterval = 60,
    threshold = 200,
    lastCleanup = os.clock()
}

task.spawn(function()
    while true do
        task.wait(memoryWatchdog.checkInterval)
        local mem = collectgarbage("count") / 1024
        if mem > memoryWatchdog.threshold then
            collectgarbage("collect")
            cache.pets.value = nil
            cache.nests.value = nil
            memoryWatchdog.lastCleanup = os.clock()
        end
    end
end)

-- Batch processing
local batchQueue = {}
local BATCH_SIZE = 10
local BATCH_INTERVAL = 0.5

local function addToBatch(func)
    table.insert(batchQueue, func)
    if #batchQueue >= BATCH_SIZE then
        for _, f in ipairs(batchQueue) do
            pcall(f)
        end
        batchQueue = {}
    end
end

task.spawn(function()
    while true do
        task.wait(BATCH_INTERVAL)
        if #batchQueue > 0 then
            for _, f in ipairs(batchQueue) do
                pcall(f)
            end
            batchQueue = {}
        end
    end
end)

