-- Cache inteligente com TTL dinâmico
local cache = {
    pets = { value = nil, lastUpdate = 0, ttl = 0.5 },
    nests = { value = nil, lastUpdate = 0, ttl = 10 },
    zones = { boss = {}, enemy = {}, food = {}, egg = {} }
}

local function getCached(key, fetchFunc)
    local c = cache[key]
    if not c.value or os.clock() - c.lastUpdate > c.ttl then
        c.value = fetchFunc()
        c.lastUpdate = os.clock()
    end
    return c.value
end

